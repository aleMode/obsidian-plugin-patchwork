{
	"name": "patchwork",
	"version": "0.0.1",
	"description": "Compose boards of fixed-size pages from live references to notes and PDF regions, and export them to PDF/PNG.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "node scripts/e2e/run.mjs",
		"lint": "eslint .",
		"fixtures": "node scripts/makeFixtures.mjs",
		"spikes:build": "tsc -p spikes -noEmit && node spikes/esbuild.config.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@cantoo/pdf-lib": "^2.11.1"
	}
}
