# dependencies
node_modules/

# build output
main.js
*.js.map

# Obsidian: commit only the test vault's base config; everything else is runtime state
data.json
test-vault/.obsidian/*
!test-vault/.obsidian/app.json
!test-vault/.obsidian/community-plugins.json
# private test material (e.g. real rulebooks for perf checks); never committed
test-vault/_private/
# Obsidian trash (files deleted while testing)
test-vault/.trash/
# only the generated fixture PDF is committed; real rulebooks dropped in PDFs/ stay local
test-vault/PDFs/*.pdf
!test-vault/PDFs/Sample rulebook.pdf

# editors / OS
.vscode/
.idea/
.DS_Store

# local Obsidian profile used for automated spike runs
.dev/
.dev-build.log
